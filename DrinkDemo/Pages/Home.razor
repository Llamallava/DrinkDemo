@page "/home"
@using DrinkDemo.Models;

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@code
{
    List<Drink> drinks = new()
    {   
        new Juice(drink_name: "Orange Juice", is_carbonated: false, fruit_type: "oranges"),
        new Beer(drink_name: "Budweiser", is_carbonated: true, alcohol_content_percentage: 5.0),
        new Soda(drink_name: "Pepsi", is_carbonated: true)
    };

    IEnumerable<string>? drink_descriptions;
    string? combined_descriptions;

    protected override void OnInitialized()
    {
        drink_descriptions = drinks.Select(drink => drink.description);
        combined_descriptions = string.Join(". ", drink_descriptions) + ".";
    }
}

<p>@combined_descriptions</p>