@page "/"
@page "/vending-machine"

@using DrinkDemo.Models

<div class="vending-machine">

    <div class="vm-buttons">
        @foreach (var option in drink_options)
        {
            var o = option;
            <button type="button" 
                    class="vm-button vm-button--@(o.Drink.drink_name.ToLowerInvariant()) 
                    @(selected_drink == o.Drink ? "is-active" : "")"
                    @onclick="@(() => SelectDrink(o.Drink))">

                <span class="vm-button-image-frame">
                    <img src="@o.ImagePath" alt="@o.Drink.drink_name" class="vm-button-image"/>
                </span>
                <span class="vm-button-name">@o.Drink.drink_name</span>

            </button>


        }

    </div>

    <div class="vm-display-housing">
        <div class="vm-display">
            <span class="vm-display-text" style="@scroll_style" @key="display_text">@display_text</span>
        </div>
    </div>
</div>

@code 
{
    private sealed record DrinkOption(Drink Drink, string ImagePath);

    private readonly List<DrinkOption> drink_options = new()
    {
        new DrinkOption(new Juice(drink_name: "Orange Juice", is_carbonated: false, fruit_type: "oranges"), "/images/Orange_Juice.jpg"),
        new DrinkOption(new Beer(drink_name: "Budweiser", is_carbonated: true, alcohol_content_percentage: 5.0), "/images/Budweiser.jpg"),
        new DrinkOption(new Soda(drink_name: "Pepsi", is_carbonated: true), "/images/Pepsi.jpg"),
        new DrinkOption(new Juice(drink_name: "Apple Juice", is_carbonated: false, fruit_type: "apples"), "/images/Apple_Juice.jpg"),
        new DrinkOption(new Beer(drink_name: "Heineken", is_carbonated: true, alcohol_content_percentage: 5.0), "/images/Heineken.jpg"),
        new DrinkOption(new Soda(drink_name: "Fanta", is_carbonated: true), "/images/Fanta.jpg")
    };

    private Drink? selected_drink;

    private string display_text => selected_drink is null
        ? "PRESS A BUTTON"
        : selected_drink.description.ToUpperInvariant();

    private string scroll_style
    {
        get
        {
            double seconds = Math.Max(4, display_text.Length * 0.22);
            return $"--scroll-duration: {seconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}s;";
        }
    }

    private void SelectDrink(Drink drink)
    {
        selected_drink = drink;
    }
}